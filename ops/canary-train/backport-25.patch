+  };
+  return {
+    promise,
+    get failure() { return failure; },
+    start(label: string) {
+      if (started || closed || failure) return;
+      started = true;
+      schedule(label);
+    },
+    responseCompleted(label: string) {
+      if (!started || closed || failure) return;
+      schedule(label);
