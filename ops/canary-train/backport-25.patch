+      }
+
+      for (const sourceId of sourceIds) {
+        const leases = await tx.select().from(environmentLeases).where(and(
+          eq(environmentLeases.companyId, task.companyId),
+          eq(environmentLeases.heartbeatRunId, sourceId),
+        ));
