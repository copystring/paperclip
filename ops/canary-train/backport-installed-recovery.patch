+import { describe, expect, it } from "vitest";
+import { searchOnDemandTools } from "./on-demand-tool-search.js";
+
+const tools = [
+  { name: "tool_docs", displayName: "Search docs", description: "PowerShell and Windows administration" },
+  { name: "windows-shell", displayName: "Run PowerShell", applicationDisplayName: "Windows Tools", description: "Execute a command" },
+  { name: "ps_info", displayName: "PowerShell details", applicationDisplayName: "Windows" },
+  { name: "unrelated", displayName: "Calendar", description: "Manage events" },
+];
+
+describe("searchOnDemandTools", () => {
+  it("normalizes punctuation and hyphens, matches query tokens across fields, and ranks names above descriptions", () => {
+    expect(searchOnDemandTools(tools, "Windows PowerShell", 10).map((tool) => tool.name)).toEqual([
+      "windows-shell",
+      "ps_info",
+      "tool_docs",
+    ]);
+    expect(searchOnDemandTools(tools, "windows-PowerShell", 10).map((tool) => tool.name)).toEqual([
+      "windows-shell",
+      "ps_info",
+      "tool_docs",
+    ]);
+  });
+
+  it("searches application display names and applies the limit after relevance ordering", () => {
+    expect(searchOnDemandTools(tools, "Windows", 1).map((tool) => tool.name)).toEqual(["windows-shell"]);
+  });
+
+  it("retains partial-token search and normalizes Unicode diacritics", () => {
+    expect(searchOnDemandTools(tools, "powersh", 10).map((tool) => tool.name)).toEqual([
+      "windows-shell",
+      "ps_info",
+      "tool_docs",
+    ]);
+    expect(searchOnDemandTools([{ name: "prüfen" }], "prufen", 10)).toEqual([{ name: "prüfen" }]);
+  });
+
+  it("preserves discovery order for an empty query and returns no tools for no match", () => {
+    expect(searchOnDemandTools(tools, "---", 2).map((tool) => tool.name)).toEqual(["tool_docs", "windows-shell"]);
+    expect(searchOnDemandTools(tools, "qzxv-blorf", 10)).toEqual([]);
+  });
+});
diff --git a/server/src/services/on-demand-tool-search.ts b/server/src/services/on-demand-tool-search.ts
new file mode 100644
index 000000000..1b5da5e76
--- /dev/null
+++ b/server/src/services/on-demand-tool-search.ts
@@ -0,0 +1,55 @@
+type SearchableOnDemandTool = {
+  name: string;
+  displayName?: string | null;
+  description?: string | null;
+  applicationDisplayName?: string | null;
+  applicationKey?: string | null;
+  upstreamToolName?: string | null;
+};
+
+function searchTokens(value: string): string[] {
+  return value
+    .normalize("NFKD")
+    .replace(/\p{M}+/gu, "")
+    .toLowerCase()
+    .match(/[\p{L}\p{N}]+/gu) ?? [];
+}
+
+/** Search only the caller-provided authorized set; preserve its order for an empty query. */
+export function searchOnDemandTools<T extends SearchableOnDemandTool>(
+  tools: readonly T[],
+  query: string,
+  limit: number,
+): T[] {
+  const terms = [...new Set(searchTokens(query))];
+  const boundedLimit = Math.max(1, Math.min(50, Math.floor(limit) || 10));
+  if (terms.length === 0) return tools.slice(0, boundedLimit);
+
+  const fields = (tool: T) => [
+    [tool.name, 8],
+    [tool.displayName, 7],
+    [tool.applicationDisplayName, 6],
+    [tool.upstreamToolName, 5],
+    [tool.applicationKey, 4],
+    [tool.description, 1],
+  ] as const;
+
+  return tools
+    .map((tool, index) => {
+      const searchable = fields(tool).map(([value, weight]) => ({
+        tokens: searchTokens(typeof value === "string" ? value : ""),
+        weight,
+      }));
+      const termScores = terms.map((term) => Math.max(0, ...searchable.flatMap((field) => {
+        const exact = field.tokens.includes(term);
+        const partial = !exact && field.tokens.some((token) => token.includes(term));
+        return exact ? [field.weight] : partial ? [Math.max(1, field.weight - 1)] : [];
+      })));
+      const matchedTerms = termScores.filter((score) => score > 0).length;
+      return { tool, index, matchedTerms, score: termScores.reduce((sum, score) => sum + score, 0) };
+    })
+    .filter((result) => result.matchedTerms > 0)
+    .sort((a, b) => b.matchedTerms - a.matchedTerms || b.score - a.score || a.index - b.index)
+    .slice(0, boundedLimit)
+    .map(({ tool }) => tool);
+}
